{
  "$schema": "https://flow-next.dev/schema/flow-config.schema.json",
  "chart": {
    "claimStaleAfter": 24,
    "maxDecisions": 12
  },
  "features": {
    "staleAfterCommits": 50
  },
  "judge": {
    "enabled": true
  },
  "land": {
    "mergeVerdictCommand": "",
    "patienceMinutes": 10
  },
  "memory": {
    "enabled": true
  },
  "pilot": {
    "autonomy": "ready",
    "gateClasses": []
  },
  "pipeline": {
    "qa": "off"
  },
  "planSync": {
    "crossSpec": false,
    "enabled": false
  },
  "review": {
    "backend": "codex:gpt-6-astra:xhigh",
    "maxIterations": 8
  },
  "scouts": {
    "github": false
  },
  "tracker": {
    "charts": "off",
    "conflictTiebreak": "always-ask",
    "enabled": true,
    "perEvent": {
      "capture": "off",
      "completionReview": "off",
      "interview": "off",
      "land": {
        "merged": "off"
      },
      "makePr": "off",
      "plan": "off",
      "qa": "off",
      "resolvePr": "off",
      "work": {
        "done": "off",
        "firstClaim": "off"
      }
    },
    "perTracker": {
      "apiVersion": null,
      "authScheme": null,
      "baseUrl": null,
      "host": null,
      "labelMap": {},
      "priorityMap": {},
      "project": null,
      "projectId": null,
      "projectKey": null,
      "repo": "wapp-its/meeting-transcriber",
      "sslVerify": true,
      "statusMap": {},
      "teamId": null
    },
    "provenance": null,
    "readyState": null,
    "specIds": "tracker",
    "staleAfterHours": 24,
    "type": "github",
    "version": 1
  }
}
